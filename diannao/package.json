{
  "name": "diannao-integrated",
  "private": true,
  "version": "0.0.0",
  "description": "店脑 · B 组员邱 的本地工作目录（架构 / 数据 / 契约 / API / 迁移）",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify": "bash scripts/verify.sh",
    "build:api": "tsc -p tsconfig.api.json && node scripts/write-dist-pkg.mjs",
    "api": "npm run build:api && node dist/services/api/src/server.js",
    "test:api": "npm run build:api && node scripts/test-api.mjs",
    "eval:ai": "npm run build:api && node dist/services/ai/eval-runner.js"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "typescript": "5.6.3"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  }
}
