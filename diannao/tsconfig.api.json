{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2020"],
    "types": ["node"],
    "strict": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "rootDir": ".",
    "outDir": "dist"
  },
  "include": ["packages/contracts/**/*.ts", "services/api/src/**/*.ts"],
  "exclude": ["node_modules", "dist", "scripts"]
}
